# Tech OTT Downloader — backend settings
# Copy this file to ".env" and change the values if needed.
# Never put secrets in this file's committed copy.

# Port the downloader server listens on (must differ from
# Tech OTT 8000, portal 5000, Jellyfin 8096).
PORT=8001

# yt-dlp location. "yt-dlp" = on PATH. On Windows you can also
# point at the exe, e.g. C:\tools\yt-dlp.exe
# (or put yt-dlp.exe in this backend/ folder and use ./yt-dlp.exe)
YT_DLP_PATH=yt-dlp

# ffmpeg location (only needed for the MP3 download).
# Leave empty to use ffmpeg from PATH (WinGet installs it there).
# Or set the full path, e.g. C:\Users\Admin\AppData\Local\Microsoft\WinGet\Packages\Gyan.FFmpeg_Microsoft.WinGet.Source_8wekyb3d8bbwe\ffmpeg-9.0.2-full_build\bin\ffmpeg.exe
FFMPEG_PATH=
